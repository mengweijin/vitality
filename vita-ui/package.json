    "lint:github": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "rimraf": "rimraf dist && rimraf types && pnpm clean --lockfile",
    "preinstall": "npx only-allow pnpm",
    "check": "npm-check -u"
